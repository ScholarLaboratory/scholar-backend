generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  
}


model User {
  id        String   @id @default(uuid())
  fullName  String
  username  String   @unique
  email     String   @unique
  password  String

  bio       String?
  school    String?
  level     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}