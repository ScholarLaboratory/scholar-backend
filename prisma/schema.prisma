generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String @id @default(uuid())
  fullName String
  username String @unique
  email    String @unique
  password String

  bio    String?
  school String?
  level  String?

  hostedCompetitions Competition[] @relation("CompetitionHost")
  competitionEntries CompetitionParticipant[]
  quizSessions QuizSession[]
  sentChallenges Challenge[] @relation("ChallengeChallenger")
  receivedChallenges Challenge[] @relation("ChallengeOpponent")

  following Follow[] @relation("UserFollowing")
  followers Follow[] @relation("UserFollowers")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Follow {
  id String @id @default(uuid())

  followerId  String
  followingId String

  follower  User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Question {
  id           String @id @default(uuid())
  questionText String

  academicLevel AcademicLevel
  difficulty    Difficulty
  questionType  QuestionType   @default(MULTIPLE_CHOICE)
  source        QuestionSource
  status        QuestionStatus @default(DRAFT)

  explanation String?

  subjectId String
  topicId   String

  subject Subject @relation(fields: [subjectId], references: [id])

  topic Topic @relation(fields: [topicId], references: [id])

  quizQuestions QuizSessionQuestion[]
  quizAnswers QuizAnswer[]

  options QuestionOption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subjectId])
  @@index([topicId])
  @@index([academicLevel])
  @@index([difficulty])
  @@index([status])
}

model QuestionOption {
  id String @id @default(uuid())

  questionId String

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  optionText String
  isCorrect  Boolean

  quizAnswers QuizAnswer[]

  createdAt DateTime @default(now())

  @@index([questionId])
}

enum AcademicLevel {
  PRIMARY
  SECONDARY
  UNIVERSITY
  PROFESSIONAL
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum QuestionType {
  MULTIPLE_CHOICE
}

enum QuestionSource {
  PLATFORM
  AI
  EXTERNAL
}

enum QuestionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Subject {
  id   String @id @default(uuid())
  name String @unique
  slug String @unique

  topics    Topic[]
  questions Question[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Topic {
  id   String @id @default(uuid())
  name String
  slug String

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  questions Question[]
  challenges Challenge[]
  competitions Competition[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([subjectId, slug])
  @@index([subjectId])
}

enum QuizSessionStatus {
  IN_PROGRESS
  COMPLETED
}

model QuizSession {
  id          String @id @default(uuid())
  userId      String
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      QuizSessionStatus @default(IN_PROGRESS)
  score       Int @default(0)
  total       Int
  xpEarned    Int @default(0)
  startedAt   DateTime @default(now())
  completedAt DateTime?

  questions QuizSessionQuestion[]
  answers   QuizAnswer[]
  challengeParticipants Challenge[] @relation("ChallengerQuiz")
  opponentChallengeParticipants Challenge[] @relation("OpponentQuiz")

  @@index([userId, startedAt])
}

model QuizSessionQuestion {
  id        String @id @default(uuid())
  sessionId String
  questionId String
  position  Int
  session   QuizSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question  Question @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([sessionId, questionId])
  @@unique([sessionId, position])
}

model QuizAnswer {
  id               String @id @default(uuid())
  sessionId        String
  questionId       String
  selectedOptionId String
  isCorrect        Boolean
  createdAt        DateTime @default(now())

  session        QuizSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question       Question @relation(fields: [questionId], references: [id], onDelete: Restrict)
  selectedOption QuestionOption @relation(fields: [selectedOptionId], references: [id], onDelete: Restrict)

  @@unique([sessionId, questionId])
  @@index([questionId])
}

enum ChallengeStatus {
  PENDING
  ACTIVE
  COMPLETED
  DECLINED
}

model Challenge {
  id String @id @default(uuid())
  challengerId String
  opponentId String
  topicId String
  questionCount Int @default(10)
  durationSeconds Int @default(300)
  challengerReadyAt DateTime?
  opponentReadyAt DateTime?
  startsAt DateTime?
  endsAt DateTime?
  status ChallengeStatus @default(PENDING)
  challengerQuizId String? @unique
  opponentQuizId String? @unique
  winnerId String?
  createdAt DateTime @default(now())
  acceptedAt DateTime?
  completedAt DateTime?

  challenger User @relation("ChallengeChallenger", fields: [challengerId], references: [id], onDelete: Cascade)
  opponent User @relation("ChallengeOpponent", fields: [opponentId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Restrict)
  challengerQuiz QuizSession? @relation("ChallengerQuiz", fields: [challengerQuizId], references: [id], onDelete: SetNull)
  opponentQuiz QuizSession? @relation("OpponentQuiz", fields: [opponentQuizId], references: [id], onDelete: SetNull)

  @@index([challengerId, createdAt])
  @@index([opponentId, status])
}

enum CompetitionStatus {
  DRAFT
  OPEN
  CLOSED
}

model Competition {
  id String @id @default(uuid())
  title String
  facilitatorId String
  topicId String
  questionCount Int @default(10)
  durationSeconds Int @default(300)
  status CompetitionStatus @default(DRAFT)
  scheduledAt DateTime?
  createdAt DateTime @default(now())
  facilitator User @relation("CompetitionHost", fields: [facilitatorId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Restrict)
  participants CompetitionParticipant[]
  @@index([facilitatorId, createdAt])
}

model CompetitionParticipant {
  competitionId String
  userId String
  joinedAt DateTime @default(now())
  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([competitionId, userId])
}
